{
  "name": "linear-dashboard",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "sh scripts/build.sh",
    "check": "bunx openchamber-guest-check",
    "typecheck": "bunx tsc --noEmit -p .",
    "validate-queries": "bun scripts/validate-queries.ts",
    "test": "bun test",
    "fixtures": "bun scripts/fixtures.ts",
    "smoke": "bun scripts/service-smoke.ts",
    "e2e": "sh scripts/build.sh && bun scripts/fixtures.ts && bun e2e/run.ts"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.0"
    },
    "id": "linear-dashboard",
    "name": "Linear+",
    "icon": "icon.svg",
    "contributes": {
      "panel": {
        "entry": "panel/index.html"
      },
      "page": true,
      "attach": {
        "mode": "dialog",
        "entry": "dialog/index.html"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "Linear+",
        "height": 160,
        "requiresProject": true
      },
      "capabilities": ["prompt", "sessions", "files", "model"],
      "origins": ["https://uploads.linear.app", "https://public.linear.app"],
      "integration": {
        "name": "Linear+",
        "description": "Uses your OpenChamber Linear connection. Optional: a personal API key keeps agent context and @ rows fresh while the dashboard is closed.",
        "host": {
          "provider": "linear"
        },
        "settings": [{
          "id": "api-key",
          "label": "Personal API key (optional)",
          "secret": true
        }]
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      },
      "sessionEvents": {
        "events": ["session-created", "turn-started", "turn-finished"],
        "content": true
      },
      "sessionControl": {
        "content": true
      },
      "instructions": true,
      "mentions": {
        "label": "Linear+"
      },
      "background": {
        "entry": "background/index.html"
      },
      "commands": [
        {
          "name": "linear-issue",
          "description": "Show an issue card: /linear-issue ENG-123, a number, or words"
        },
        {
          "name": "linear-list",
          "description": "Show a list of issues: /linear-list [ENG-1 ENG-2] [heading]"
        },
        {
          "name": "linear-pick",
          "description": "Ask which issue: /linear-pick [ENG-1 ENG-2] [question]"
        }
      ],
      "actions": [
        {
          "id": "issue-from-message",
          "label": "Create Linear issue",
          "where": "message",
          "icon": "add-circle"
        },
        {
          "id": "issue-from-selection",
          "label": "Create Linear issue",
          "where": "selection",
          "icon": "add-circle",
          "display": "both"
        },
        {
          "id": "issue-from-session",
          "label": "Create Linear issue from chat",
          "where": "session",
          "payload": ["messages"]
        },
        {
          "id": "issue-from-diff",
          "label": "Create Linear issue",
          "where": "diff",
          "icon": "add-circle"
        },
        {
          "id": "build-from-plan",
          "label": "Start build from this plan",
          "where": "session"
        },
        {
          "id": "comment-on-issue",
          "label": "Comment on Linear issue",
          "where": "message",
          "icon": "chat-1"
        }
      ],
      "blocks": [
        {
          "name": "LinearIssue",
          "description": "Shows one Linear issue live: status, assignee, priority. id: identifier like ENG-123",
          "args": ["id"],
          "entry": "blocks/index.html",
          "height": 120
        },
        {
          "name": "LinearIssueList",
          "description": "Shows several Linear issues as a live list. title: heading, ids: identifiers separated by commas",
          "args": ["title", "ids"],
          "entry": "blocks/index.html",
          "height": 200
        },
        {
          "name": "LinearPickIssue",
          "description": "Asks the user to pick one Linear issue. question: what to ask, ids: identifiers separated by commas",
          "args": ["question", "ids"],
          "entry": "blocks/index.html",
          "height": 200,
          "answers": true
        }
      ]
    }
  },
  "dependencies": {
    "@openchamber-ext/shared-ui": "../shared-ui",
    "@openchamber/sdk": "2.7.0",
    "dompurify": "^3.4.17",
    "markdown-it": "14.3.3",
    "marked": "^18.1.3",
    "preact": "^11.2.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.9",
    "prosemirror-model": "1.25.13",
    "prosemirror-schema-list": "1.6.0",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.5",
    "prosemirror-view": "1.42.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "graphql": "^17.1.0",
    "playwright-core": "1.65.0",
    "typescript": "^7.0.2"
  }
}
